# punch.trade — environment template.
# Copy to `.env` and adjust. All values are placeholders; never commit `.env`.
# Variable names match app/config.py exactly.

# ---- Application ----
PUNCH_TOKEN=punch-demo-token
# research | paper | live  (live refuses the default demo token)
PUNCH_MODE=paper

# ---- Storage ----
PUNCH_DB_PATH=data/punch.db

# ---- Market simulation ----
PUNCH_BAR_SECONDS=4.0

# ---- Risk limits (see docs/RISK.md) ----
PUNCH_SIGNAL_TTL=300
PUNCH_EXIT_TIMEOUT_BARS=120
PUNCH_CIRCUIT_BREAKER_LOSSES=3
PUNCH_RISK_PER_TRADE_PCT=0.01
PUNCH_MAX_POSITIONS=5
PUNCH_MAX_QTY=10000
PUNCH_DAILY_LOSS_PCT=5.0
PUNCH_FEED_STALE_AFTER=

# ---- Optional Telegram alerts ----
PUNCH_TELEGRAM_BOT_TOKEN=
PUNCH_TELEGRAM_CHAT_ID=

# ---- Local AI analyst (Ollama) ----
PUNCH_OLLAMA_HOST=http://127.0.0.1:11434
# Leave empty for auto-detect of installed qwen2.5* models.
PUNCH_OLLAMA_MODEL=

# ---- Test safety tripwire ----
# Must remain unset/false everywhere except deliberate local live-broker
# integration tests. CI never sets this.
PUNCH_ALLOW_LIVE_TESTS=false